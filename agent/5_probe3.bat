@echo off
chcp 65001 >nul
rem Sapar Trade: кладёт новые диагностические запросы в queries\probe и запускает проверку 1С.
rem Положите этот файл в папку агента (рядом с sapar-1c-agent.ps1) и запустите двойным щелчком.
cd /d "%~dp0"
if not exist "%~dp0sapar-1c-agent.ps1" (
  echo Этот файл нужно положить в папку агента, рядом с sapar-1c-agent.ps1
  pause
  exit /b 1
)
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $t=[IO.File]::ReadAllText('%~f0'); $i=$t.LastIndexOf('::DATA::'); $b=[Convert]::FromBase64String(($t.Substring($i+8) -replace '\s','')); $d=Join-Path '%~dp0' 'queries\probe'; New-Item -ItemType Directory -Force $d | Out-Null; Get-ChildItem $d -Recurse -Filter *.1c | Remove-Item -Force; Get-ChildItem $d -Directory | Remove-Item -Recurse -Force; $z=Join-Path ([IO.Path]::GetTempPath()) 'st-probe3.zip'; [IO.File]::WriteAllBytes($z,$b); Add-Type -AssemblyName System.IO.Compression.FileSystem; $a=[IO.Compression.ZipFile]::OpenRead($z); foreach($e in $a.Entries){ if($e.Name){ [IO.Compression.ZipFileExtensions]::ExtractToFile($e,(Join-Path $d $e.Name),$true) } }; $a.Dispose(); Remove-Item $z; Write-Host 'Запросы положены в' $d; Get-ChildItem $d | ForEach-Object { Write-Host '  ' $_.Name }"
if errorlevel 1 (
  echo Не получилось положить запросы. Сделайте фото экрана и отправьте разработчику.
  pause
  exit /b 1
)
echo.
call "%~dp02_check-1c.bat"
exit /b

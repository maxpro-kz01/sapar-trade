// 1С:Бухгалтерия для Казахстана — долги покупателей по счёту 1274 (ТЗ TZ_DEBTS_BUH).
// kind = "bal": сальдо сейчас по контрагенту (Дт − Кт), как в ОСВ у бухгалтера.
// kind = "dt":  отгрузки (обороты Дт) по дням за год — сервер по ним считает возраст долга (FIFO).
// Субсчета 1274 (если есть) входят: ПОДОБНО "1274%". Группы контрагентов не выводятся — только магазины.
ВЫБРАТЬ
	"bal" КАК kind,
	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Контрагенты).Код КАК client,
	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Контрагенты).Наименование КАК clientName,
	ДАТАВРЕМЯ(1, 1, 1) КАК dt,
	СУММА(ЕСТЬNULL(Ост.СуммаОстатокДт, 0) - ЕСТЬNULL(Ост.СуммаОстатокКт, 0)) КАК amount
ИЗ
	РегистрБухгалтерии.Типовой.Остатки(&Сейчас, Счет.Код ПОДОБНО "1274%", ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоТиповые.Контрагенты), ) КАК Ост
ГДЕ
	ЕСТЬNULL(ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Контрагенты).Код, "") <> ""
СГРУППИРОВАТЬ ПО
	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Контрагенты).Код,
	ВЫРАЗИТЬ(Ост.Субконто1 КАК Справочник.Контрагенты).Наименование

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	"dt",
	ВЫРАЗИТЬ(Об.Субконто1 КАК Справочник.Контрагенты).Код,
	ВЫРАЗИТЬ(Об.Субконто1 КАК Справочник.Контрагенты).Наименование,
	НАЧАЛОПЕРИОДА(Об.Период, ДЕНЬ),
	СУММА(Об.СуммаОборотДт)
ИЗ
	РегистрБухгалтерии.Типовой.Обороты(&Начало, &Конец, День, Счет.Код ПОДОБНО "1274%", ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоТиповые.Контрагенты), , , ) КАК Об
ГДЕ
	ЕСТЬNULL(ВЫРАЗИТЬ(Об.Субконто1 КАК Справочник.Контрагенты).Код, "") <> ""
СГРУППИРОВАТЬ ПО
	ВЫРАЗИТЬ(Об.Субконто1 КАК Справочник.Контрагенты).Код,
	ВЫРАЗИТЬ(Об.Субконто1 КАК Справочник.Контрагенты).Наименование,
	НАЧАЛОПЕРИОДА(Об.Период, ДЕНЬ)
ИМЕЮЩИЕ
	СУММА(Об.СуммаОборотДт) <> 0

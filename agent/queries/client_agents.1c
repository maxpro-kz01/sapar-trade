// ТП клиента (ТЗ финансов v1.2, часть E). Источник 1 — мобильный агент (Эдванс Агент) в проведённых реализациях за 90 дней;
// источник 2 — имя основного договора покупателя (у многих договор назван именем ТП). Выбор ТП делает сервер.
ВЫБРАТЬ
	Р.Контрагент.Код КАК client,
	ПРЕДСТАВЛЕНИЕ(Р.МобильныйАгент) КАК agent,
	1 КАК source,
	КОЛИЧЕСТВО(*) КАК docs,
	МАКСИМУМ(Р.Дата) КАК lastDay
ИЗ
	Документ.РеализацияТоваровУслуг КАК Р
ГДЕ
	Р.Дата МЕЖДУ &Начало И &Конец
	И Р.Проведен
СГРУППИРОВАТЬ ПО
	Р.Контрагент.Код,
	Р.МобильныйАгент

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	К.Код,
	К.ОсновнойДоговорКонтрагента.Наименование,
	2,
	0,
	ДАТАВРЕМЯ(1, 1, 1)
ИЗ
	Справочник.Контрагенты КАК К
ГДЕ
	НЕ К.ЭтоГруппа
	И НЕ К.ПометкаУдаления
	И К.Покупатель

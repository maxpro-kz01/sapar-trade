// Товары (Справочник.Номенклатура), без групп и помеченных на удаление.
ВЫБРАТЬ
	Н.Код КАК code,
	Н.Наименование КАК name,
	ЕСТЬNULL(Н.Родитель.Наименование, "") КАК groupName,
	ЕСТЬNULL(Н.ЕдиницаХраненияОстатков.Наименование, "") КАК unit,
	Н.Артикул КАК sku
ИЗ
	Справочник.Номенклатура КАК Н
ГДЕ
	НЕ Н.ЭтоГруппа
	И НЕ Н.ПометкаУдаления

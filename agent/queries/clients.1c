// Покупатели (Справочник.Контрагенты) с основным менеджером — по нему ТП видит «своих» клиентов.
// Телефон и адрес — из регистра контактной информации, группировка во вложенных запросах: в основном запросе
// группировки нет, потому что 1С не разрешает поля составного типа (основной договор) рядом с СГРУППИРОВАТЬ ПО.
ВЫБРАТЬ
	К.Код КАК code,
	К.Наименование КАК name,
	ЕСТЬNULL(К.ОсновнойМенеджерПокупателя.Наименование, "") КАК manager,
	ЕСТЬNULL(Тел.Пред, "") КАК phone,
	ЕСТЬNULL(Адр.Пред, "") КАК address,
	ЕСТЬNULL(Дог.ТипЦен.Наименование, "") КАК priceType
ИЗ
	Справочник.Контрагенты КАК К
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК Дог
		ПО Дог.Ссылка = К.ОсновнойДоговорКонтрагента
		ЛЕВОЕ СОЕДИНЕНИЕ (
			ВЫБРАТЬ
				КИ.Объект КАК Объект,
				МАКСИМУМ(ВЫРАЗИТЬ(КИ.Представление КАК СТРОКА(100))) КАК Пред
			ИЗ
				РегистрСведений.КонтактнаяИнформация КАК КИ
			ГДЕ
				КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
			СГРУППИРОВАТЬ ПО
				КИ.Объект
		) КАК Тел
		ПО Тел.Объект = К.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ (
			ВЫБРАТЬ
				КИ.Объект КАК Объект,
				МАКСИМУМ(ВЫРАЗИТЬ(КИ.Представление КАК СТРОКА(300))) КАК Пред
			ИЗ
				РегистрСведений.КонтактнаяИнформация КАК КИ
			ГДЕ
				КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
			СГРУППИРОВАТЬ ПО
				КИ.Объект
		) КАК Адр
		ПО Адр.Объект = К.Ссылка
ГДЕ
	НЕ К.ЭтоГруппа
	И НЕ К.ПометкаУдаления
	И К.Покупатель

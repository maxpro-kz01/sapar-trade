// Покупатели (Справочник.Контрагенты) с основным менеджером — по нему ТП видит «своих» клиентов.
// Телефон и адрес — из регистра контактной информации (первое значение).
ВЫБРАТЬ
	К.Код КАК code,
	К.Наименование КАК name,
	ЕСТЬNULL(К.ОсновнойМенеджерПокупателя.Наименование, "") КАК manager,
	ЕСТЬNULL(МАКСИМУМ(Тел.Представление), "") КАК phone,
	ЕСТЬNULL(МАКСИМУМ(Адр.Представление), "") КАК address
ИЗ
	Справочник.Контрагенты КАК К
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК Тел
		ПО (Тел.Объект = К.Ссылка)
			И (Тел.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК Адр
		ПО (Адр.Объект = К.Ссылка)
			И (Адр.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес))
ГДЕ
	НЕ К.ЭтоГруппа
	И НЕ К.ПометкаУдаления
	И К.Покупатель
СГРУППИРОВАТЬ ПО
	К.Код,
	К.Наименование,
	К.ОсновнойМенеджерПокупателя.Наименование

// Сверка долгов с Бухгалтерией (ТЗ TZ_DEBTS_FIX): 4 клиента — остаток по договору, виду договора и типу документа.
// Бухгалтерия (ОСВ 1274): Орда су 589 662, ПИЦЦА ДОНЕР 159 355, Магнит Абуова 10 488, B.BEGIMSULU 153 510.
ВЫБРАТЬ
	Расч.Контрагент.Наименование КАК client,
	Расч.ДоговорКонтрагента.Наименование КАК contract,
	ПРЕДСТАВЛЕНИЕ(Расч.ДоговорКонтрагента.ВидДоговора) КАК kind,
	ПРЕДСТАВЛЕНИЕ(ТИПЗНАЧЕНИЯ(Расч.Документ)) КАК docType,
	КОЛИЧЕСТВО(*) КАК n,
	СУММА(Расч.СуммаУпрОстаток) КАК upr,
	СУММА(Расч.СуммаВзаиморасчетовОстаток) КАК vz
ИЗ
	РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки(&Сейчас, ) КАК Расч
ГДЕ
	(Расч.Контрагент.Наименование ПОДОБНО "%Орда су Училищн%" ИЛИ Расч.Контрагент.Наименование ПОДОБНО "%ПИЦЦА ДОНЕР%"
		ИЛИ Расч.Контрагент.Наименование ПОДОБНО "%Магнит ул. Абуова%" ИЛИ Расч.Контрагент.Наименование ПОДОБНО "%BEGIMSULU%")
СГРУППИРОВАТЬ ПО
	Расч.Контрагент.Наименование,
	Расч.ДоговорКонтрагента.Наименование,
	Расч.ДоговорКонтрагента.ВидДоговора,
	ТИПЗНАЧЕНИЯ(Расч.Документ)
УПОРЯДОЧИТЬ ПО
	client

// 4 клиента: приходные кассовые ордера за 90 дней — есть ли оплаты в УТП, проведены ли, на какой вид договора.
ВЫБРАТЬ
	П.Контрагент.Наименование КАК client,
	П.Проведен КАК posted,
	ПРЕДСТАВЛЕНИЕ(П.ДоговорКонтрагента.ВидДоговора) КАК kind,
	КОЛИЧЕСТВО(*) КАК n,
	СУММА(П.СуммаДокумента) КАК amount
ИЗ
	Документ.ПриходныйКассовыйОрдер КАК П
ГДЕ
	(П.Контрагент.Наименование ПОДОБНО "%Орда су Училищн%" ИЛИ П.Контрагент.Наименование ПОДОБНО "%ПИЦЦА ДОНЕР%"
		ИЛИ П.Контрагент.Наименование ПОДОБНО "%Магнит ул. Абуова%" ИЛИ П.Контрагент.Наименование ПОДОБНО "%BEGIMSULU%")
	И П.Дата >= ДОБАВИТЬКДАТЕ(&Сейчас, ДЕНЬ, -90)
СГРУППИРОВАТЬ ПО
	П.Контрагент.Наименование,
	П.Проведен,
	П.ДоговорКонтрагента.ВидДоговора
УПОРЯДОЧИТЬ ПО
	client

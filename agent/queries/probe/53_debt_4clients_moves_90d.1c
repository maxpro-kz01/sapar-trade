// 4 клиента: движения взаиморасчётов за 90 дней по типу документа и договору — какие документы уменьшают долг.
ВЫБРАТЬ
	Расч.Контрагент.Наименование КАК client,
	ПРЕДСТАВЛЕНИЕ(ТИПЗНАЧЕНИЯ(Расч.Регистратор)) КАК regType,
	ПРЕДСТАВЛЕНИЕ(Расч.ВидДвижения) КАК mv,
	ПРЕДСТАВЛЕНИЕ(Расч.ДоговорКонтрагента.ВидДоговора) КАК kind,
	КОЛИЧЕСТВО(*) КАК n,
	СУММА(Расч.СуммаУпр) КАК upr
ИЗ
	РегистрНакопления.ВзаиморасчетыСКонтрагентами КАК Расч
ГДЕ
	(Расч.Контрагент.Наименование ПОДОБНО "%Орда су Училищн%" ИЛИ Расч.Контрагент.Наименование ПОДОБНО "%ПИЦЦА ДОНЕР%"
		ИЛИ Расч.Контрагент.Наименование ПОДОБНО "%Магнит ул. Абуова%" ИЛИ Расч.Контрагент.Наименование ПОДОБНО "%BEGIMSULU%")
	И Расч.Период >= ДОБАВИТЬКДАТЕ(&Сейчас, ДЕНЬ, -90)
СГРУППИРОВАТЬ ПО
	Расч.Контрагент.Наименование,
	ТИПЗНАЧЕНИЯ(Расч.Регистратор),
	Расч.ВидДвижения,
	Расч.ДоговорКонтрагента.ВидДоговора
УПОРЯДОЧИТЬ ПО
	client

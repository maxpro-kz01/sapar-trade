// Продажи по дням (РегистрНакопления.Продажи): количество и выручка по товару и клиенту.
// &Начало / &Конец задаёт агент (последние дни с запасом на перепроведение).
ВЫБРАТЬ
	П.Период КАК dt,
	П.Номенклатура.Код КАК product,
	ЕСТЬNULL(П.Контрагент.Код, "") КАК client,
	СУММА(П.КоличествоОборот) КАК qty,
	СУММА(П.СтоимостьОборот) КАК revenue
ИЗ
	РегистрНакопления.Продажи.Обороты(&Начало, &Конец, День, ) КАК П
СГРУППИРОВАТЬ ПО
	П.Период,
	П.Номенклатура.Код,
	ЕСТЬNULL(П.Контрагент.Код, "")

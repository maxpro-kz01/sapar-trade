// Долги покупателей сейчас (РегистрНакопления.ВзаиморасчетыСКонтрагентами), по сделке — для «возраста долга».
// Сумма в валюте управленческого учёта (тенге). Плюс — клиент должен нам, минус — аванс клиента.
ВЫБРАТЬ
	В.ДоговорКонтрагента.Владелец.Код КАК client,
	ВЫБОР
		КОГДА В.Сделка = НЕОПРЕДЕЛЕНО ИЛИ В.Сделка ЕСТЬ NULL ТОГДА НЕОПРЕДЕЛЕНО
		ИНАЧЕ В.Сделка.Дата
	КОНЕЦ КАК docDate,
	ПРЕДСТАВЛЕНИЕ(В.Сделка) КАК docName,
	СУММА(В.СуммаУпрОстаток) КАК amount
ИЗ
	РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки(&Сейчас, ) КАК В
ГДЕ
	В.ДоговорКонтрагента.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)
СГРУППИРОВАТЬ ПО
	В.ДоговорКонтрагента.Владелец.Код,
	В.Сделка
ИМЕЮЩИЕ
	СУММА(В.СуммаУпрОстаток) <> 0

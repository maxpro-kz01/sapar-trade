// Долги покупателей сейчас (РегистрНакопления.ВзаиморасчетыСКонтрагентами) по документу — для «возраста долга».
// Поле «Сделка» в базе пустое, поэтому берём «Документ» (реализация, по которой долг). Без документа — начальные остатки.
// Сумма в валюте управленческого учёта (тенге). Плюс — клиент должен нам, минус — аванс клиента.
ВЫБРАТЬ
	Т.client КАК client,
	Т.Документ.Дата КАК docDate,
	ПРЕДСТАВЛЕНИЕ(Т.Документ) КАК docName,
	Т.amount КАК amount
ИЗ
	(ВЫБРАТЬ
		Расч.Контрагент.Код КАК client,
		Расч.Документ КАК Документ,
		СУММА(Расч.СуммаУпрОстаток) КАК amount
	ИЗ
		РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки(&Сейчас, ) КАК Расч
	ГДЕ
		Расч.ДоговорКонтрагента.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)
		И ЕСТЬNULL(Расч.Контрагент.Код, "") <> ""
	СГРУППИРОВАТЬ ПО
		Расч.Контрагент.Код,
		Расч.Документ
	ИМЕЮЩИЕ
		СУММА(Расч.СуммаУпрОстаток) <> 0) КАК Т

// Долги покупателей сейчас (РегистрНакопления.ВзаиморасчетыСКонтрагентами), по сделке — для «возраста долга».
// Сумма в валюте управленческого учёта (тенге). Плюс — клиент должен нам, минус — аванс клиента.
ВЫБРАТЬ
	Расч.Контрагент.Код КАК client,
	ВЫБОР
		КОГДА Расч.Сделка = НЕОПРЕДЕЛЕНО ИЛИ Расч.Сделка ЕСТЬ NULL ТОГДА НЕОПРЕДЕЛЕНО
		ИНАЧЕ Расч.Сделка.Дата
	КОНЕЦ КАК docDate,
	ПРЕДСТАВЛЕНИЕ(Расч.Сделка) КАК docName,
	СУММА(Расч.СуммаУпрОстаток) КАК amount
ИЗ
	РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки(&Сейчас, ) КАК Расч
ГДЕ
	Расч.ДоговорКонтрагента.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)
СГРУППИРОВАТЬ ПО
	Расч.Контрагент.Код,
	Расч.Сделка
ИМЕЮЩИЕ
	СУММА(Расч.СуммаУпрОстаток) <> 0

// Остатки на складах сейчас (РегистрНакопления.ТоварыНаСкладах).
ВЫБРАТЬ
	О.Склад.Код КАК warehouse,
	О.Номенклатура.Код КАК product,
	СУММА(О.КоличествоОстаток) КАК qty
ИЗ
	РегистрНакопления.ТоварыНаСкладах.Остатки(&Сейчас, ) КАК О
ГДЕ
	ЕСТЬNULL(О.Номенклатура.Код, "") <> ""
	И ЕСТЬNULL(О.Склад.Код, "") <> ""
СГРУППИРОВАТЬ ПО
	О.Склад.Код,
	О.Номенклатура.Код
